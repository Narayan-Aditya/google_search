{
  "manifest_version": 3,
  "name": "Insta Handle Finder (Google Search)",
  "version": "1.1.0",
  "description": "Multi-city site:instagram.com Google search for public handles, plus a full profile + posts exporter. Pauses on CAPTCHA/rate-limit; never evades.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "offscreen",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://i.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Insta Handle Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
